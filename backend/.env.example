# Backend port
PORT=4000

# JWT signing secret — change this in production
JWT_SECRET=change-me-to-a-long-random-string

# NextDNS API key (https://my.nextdns.io/account)
NEXTDNS_API_KEY=

# Public URL of your block page, e.g. https://blocked.yourplatform.com
BLOCK_PAGE_URL=http://localhost:5174

# Resend API key for admin email notifications. Leave blank to log to console.
RESEND_API_KEY=
RESEND_FROM=Filter <noreply@yourplatform.com>

# Comma-separated CORS origins (admin dashboard + block page)
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
