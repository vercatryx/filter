# Part of proxy-filter module — see /proxy-filter/README.md
#
# Copy to .env and fill in values. The parent backend (backend/.env)
# also reads these variables when the proxy-filter router is mounted.

# Hostname or IP that DEVICES use to reach the proxy. NOT "localhost" — must
# be reachable from the device. Use the LAN IP of the machine running
# Squid (e.g. 192.168.1.20) or a public hostname.
PROXY_HOST=

# Port that the Squid container listens on (host port). Default 3128.
PROXY_PORT=3128

# Path to the CA cert generated by server/ssl/generate-ca.sh. Relative paths
# are resolved against /proxy-filter/admin/router.js's directory by default.
CA_CERT_PATH=./server/ssl/ca.crt

# Where the block page is hosted. Squid redirects blocked traffic here.
# This URL must be in plain HTTP and reachable from the device — see README
# for why HTTPS doesn't work here.
BLOCK_PAGE_URL=http://blocked.yourplatform.com

# DoH URL to bake into browser policies. Used as belt-and-suspenders DNS
# filtering — blocks IP-only requests that bypass HTTP proxying.
PROXY_DOH_URL=https://family.cloudflare-dns.com/dns-query

# Container name to docker-exec into for `squid -k reconfigure`. Matches
# container_name in docker-compose.yml.
SQUID_CONTAINER_NAME=proxy-filter-squid
