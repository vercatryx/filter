# Auto-generated by setup-server-mac.sh and reload-config.sh.
# Do not hand-edit — the dashboard rewrites the per-device conn blocks
# below.

config setup
    charondebug = "ike 1, knl 1, cfg 1"
    uniqueids = no

conn %default
    keyexchange = ikev2
    ike = aes256gcm16-prfsha256-modp4096,aes256-sha256-modp4096!
    esp = aes256gcm16-modp4096,aes256-sha256-modp4096!
    fragmentation = yes
    forceencaps = yes
    rekey = no
    dpdaction = clear
    dpddelay = 30s
    auto = add

    # --- left = us, the server ---
    left = %any
    leftcert = vpn-server.crt
    leftsendcert = always
    leftsubnet = 0.0.0.0/0
    leftauth = pubkey

    # --- right = each connecting device ---
    right = %any
    rightauth = pubkey
    rightca = "CN=Proxy Filter CA"
    rightdns = 1.1.1.1, 1.0.0.1

# ---------------- per-device connections (managed by dashboard) ----------------
