# Installed by setup-server-vps.sh to /etc/systemd/system/.
# {{REPO_DIR}} is substituted to the on-server checkout path.

[Unit]
Description=proxy-filter mitmproxy (transparent SSL inspection)
After=network-online.target strongswan-starter.service
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/mitmdump \
    --mode transparent \
    --listen-host 127.0.0.1 \
    --listen-port 8080 \
    --showhost \
    --set confdir={{REPO_DIR}}/proxy-filter/server/mitm/conf \
    --set block_global=false \
    -s {{REPO_DIR}}/proxy-filter/server/mitm/filter_addon.py
Restart=always
RestartSec=2

# Needed for transparent mode on Linux:
#   - CAP_NET_RAW (read SO_ORIGINAL_DST)
#   - CAP_NET_BIND_SERVICE (not strictly needed at port 8080 but harmless)
AmbientCapabilities=CAP_NET_RAW CAP_NET_BIND_SERVICE
NoNewPrivileges=true

# Sandbox: limit what mitmproxy can write to.
ProtectSystem=strict
ReadWritePaths={{REPO_DIR}}/proxy-filter/server /var/log
PrivateTmp=true

StandardOutput=append:/var/log/proxyfilter-mitm.log
StandardError=append:/var/log/proxyfilter-mitm.log

User=proxyfilter
Group=proxyfilter

[Install]
WantedBy=multi-user.target
